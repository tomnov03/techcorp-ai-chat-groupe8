# Choix fait par l'équipe INFRA : ollama | triton | custom
INFERENCE_BACKEND=ollama

# URL du serveur d'inférence (donnée par l'équipe INFRA)
# Ollama  -> http://localhost:11434
# Triton  -> http://localhost:8000
# Maison  -> URL communiquée par l'équipe INFRA
INFERENCE_URL=http://localhost:11434

# Nom exact du modèle tel qu'il est servi (ex: phi3.5-financial, phi3.5:latest)
MODEL_NAME=phi3.5-financial

# Prompt système par défaut envoyé au modèle
SYSTEM_PROMPT=Tu es l'assistant financier de TechCorp Industries. Tu réponds de manière claire, professionnelle et concise aux questions de finance et de business.
